HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-with-a-long-lived-access-token
HOME_ASSISTANT_TIMEOUT=10
HOME_ASSISTANT_SERVICE_CACHE_TTL=300

HOUSE_BRAIN_API_KEY=replace-with-a-random-secret
HOUSE_BRAIN_LANGUAGE=it

# Policies live in the read-only YAML file mounted by Docker Compose.
AUTONOMY_POLICY_PATH=/app/autonomy.yaml
AUTONOMOUS_EXECUTION_ENABLED=false

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=120

# Optional: web search is exposed only to authenticated chat sessions.
SEARXNG_URL=http://host.docker.internal:8081
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=10

MEMORY_DATABASE_PATH=/data/house_brain.db
