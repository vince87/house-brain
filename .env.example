HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-with-a-long-lived-access-token
HOME_ASSISTANT_TIMEOUT=10

HOUSE_BRAIN_API_KEY=replace-with-a-random-secret

# Deny all autonomous events and actions until explicitly configured.
AUTONOMOUS_EVENT_ALLOWLIST=
AUTONOMOUS_ACTION_ALLOWLIST=
AUTONOMOUS_EXECUTION_ENABLED=false

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=120

MEMORY_DATABASE_PATH=/data/house_brain.db
