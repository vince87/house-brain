version: 2

entities:
  # Visibili in chat, eventi, API e MCP, ma mai controllabili.
  visible:
    - sensor.example_temperature
    - sun.sun

  # Visibili e controllabili da chat, eventi e API.
  include:
    - light.example_living_room
    - switch.example_fan_relay
    - cover.example_kitchen_shade
    - media_player.example_display
    - entity_id: lock.example_front_door
      code: "2468"

  # Sempre invisibili. Prevale su visible e include.
  exclude:
    - light.example_group
    - cover.example_group
    - sensor.*_diagnostic
    - sensor.*_last_seen
