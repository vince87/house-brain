version: 2

entities:
  # Visibili e controllabili da chat, eventi e API.
  include:
    - light.sala_uno
    - switch.ventola
    - cover.tapparella_cucina_due
    - media_player.tablet_p1
    - entity_id: lock.aqara_smart_lock_u200_lite
      code: "1234"

  # Invisibili ovunque. Sono accettati entity_id esatti e pattern.
  exclude:
    - light.luci
    - cover.tapparelle
    - sensor.*_diagnostic
    - sensor.*_last_seen
